# SignFlow AI — environment variables
# Copy to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

# ── Supabase (required) ─────────────────────────────────────────────
# Project Settings → API (or "API Keys"). The URL and anon/publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Used for private storage and trusted writes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Postgres connection string. Use the *transaction pooler* string from
# Project Settings → Database → Connection string (port 6543), with your database password filled in.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── App URL (recommended in production) ─────────────────────────────
# Base for signing links. If unset, the host the administrator is using is detected automatically.
APP_URL=https://your-app.vercel.app

# ── Email via Resend (optional) ─────────────────────────────────────
# Without these, everything still works: administrators copy the signing link and share it.
# onboarding@resend.dev can only send to your own Resend account address; verify a domain to email clients.
RESEND_API_KEY=
EMAIL_FROM=SignFlow AI <onboarding@resend.dev>

# ── Access control (optional) ───────────────────────────────────────
# "true" closes the public sign-up form once your reviewers have accounts.
SIGNUPS_DISABLED=false
